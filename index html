<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abisiniya Student Books</title>
    <!-- AdsGram SDK -->
    <script src="https://sad.adsgram.ai/js/sad.min.js"></script>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 40px 20px; background: #121212; color: white; }
        .btn { background: #0088cc; color: white; border: none; padding: 15px 30px; font-size: 18px; border-radius: 10px; cursor: pointer; margin-top: 20px; }
    </style>
</head>
<body>
    <h2>📚 Abisiniya Student Books</h2>
    <p>እንኳን ወደ አፕሊኬሽናችን በደህና መጡ!</p>
    
    <button class="btn" onclick="showAd()">ማስታወቂያ ይመልከቱ</button>

    <script>
        function showAd() {
            // ከ AdsGram ያገኙትን Block ID እዚህ ቦታ ያስገቡ
            const AdController = window.Adsgram.init({ blockId: "YOUR_BLOCK_ID" });
            AdController.show().then(() => {
                alert("እናመሰግናለን!");
            }).catch((err) => {
                alert("ማስታወቂያ መጫን አልተቻለም");
            });
        }
    </script>
</body>
</html>
